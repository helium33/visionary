# Firebase web app config — copy to .env.local and fill in from the Firebase console.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point the SDK at the local emulator suite during development.
VITE_USE_FIREBASE_EMULATOR=false

# When no Firebase project is configured the app boots against the bundled
# demo dataset so the UI is reviewable without credentials.
VITE_DEMO_MODE=true

# Set to true ONLY when building for a static-host preview with no server-side
# URL rewriting and a sandbox that blocks service workers (e.g. a claude.ai
# Artifact) — never for the real deployment. Switches routing to HashRouter
# (so a deep link survives a reload with no server rewrite rule) and skips
# service worker registration entirely (a broken/partial SW registration
# inside such a sandbox can intercept every later fetch and blank the page
# for good, surviving any new content published afterward — the actual
# bundle just never gets a chance to load). Leave unset/false otherwise.
VITE_STATIC_PREVIEW=false
