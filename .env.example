# Firebase web app config — copy to .env.local and fill in from the Firebase console.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point the SDK at the local emulator suite during development.
VITE_USE_FIREBASE_EMULATOR=false

# When no Firebase project is configured the app boots against the bundled
# demo dataset so the UI is reviewable without credentials.
VITE_DEMO_MODE=true

# Static-host preview builds (e.g. a claude.ai Artifact): HashRouter instead of
# BrowserRouter, and no service worker registration. Don't set it here — use
# `npm run build:preview`, which also passes `--base ./`. That half matters
# most: such a host serves the page from a sub-path, so the default absolute
# `/assets/...` URLs 404 and the page stays blank. Never for the real deployment.
VITE_STATIC_PREVIEW=false
